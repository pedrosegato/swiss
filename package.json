{
  "name": "swiss",
  "private": true,
  "version": "0.7.5",
  "description": "Desktop app for downloading videos and converting media files",
  "author": "pedro",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrosegato/swiss.git"
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc && vite build && tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "eslint . && prettier --check .",
    "uncomment": "uncomment -i ts-nocheck -i noinspection -i \"automatically generated\" -i \"You should NOT\" -i \"exclude this file\" src src-tauri/src vite.config.ts eslint.config.js",
    "uncomment:check": "uncomment --dry-run -i ts-nocheck -i noinspection -i \"automatically generated\" -i \"You should NOT\" -i \"exclude this file\" src src-tauri/src vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.166.8",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.166.8",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.0.6",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "uncomment-cli": "^3.7.0",
    "vite": "^5.1.6"
  },
  "packageManager": "pnpm@10.30.3"
}
